# Aplicación (públicas; necesarias en .env.local y en el despliegue)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Suite E2E: usa .env.test local o un archivo explícito mediante E2E_ENV_FILE.
E2E_TARGET=local
E2E_APP_URL=
E2E_START_APP=true
# Vacío usa el navegador de Playwright; "chrome" puede reutilizar Chrome instalado.
E2E_BROWSER_CHANNEL=
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
# Sólo proceso Node de pruebas; nunca NEXT_PUBLIC_* ni navegador.
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Conexión privilegiada sólo para asignar el rol staff efímero de prueba.
E2E_DATABASE_URL=
# Sólo local; Mailpit no acredita SMTP remoto.
E2E_MAILPIT_URL=

# Guard obligatorio para creación y limpieza de datos efímeros.
ALLOW_DESTRUCTIVE_E2E=false
# En staging son obligatorios y deben ser diferentes.
E2E_STAGING_PROJECT_REF=
E2E_PRODUCTION_PROJECT_REF=
# URLs conocidas de producción que Playwright bloqueará por igualdad exacta.
E2E_PRODUCTION_APP_URL=
E2E_PRODUCTION_SUPABASE_URL=
